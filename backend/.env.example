# Copy to `.env` for local development. Never commit `.env`.

# development | test | production
NODE_ENV=development
# Local HTTP port (default 3000)
PORT=3000
# pino level: fatal | error | warn | info | debug | trace | silent (default info)
LOG_LEVEL=info

# API key expected in the `x-api-key` header (local only; in AWS it comes from Secrets Manager)
API_KEY=change-me
# Local JSON with { "walletAddressUrl", "keyId", "privateKey" } (default ./keys/open-payments.json)
OPEN_PAYMENTS_KEYS_FILE=./keys/open-payments.json

# Lambda only (set by the infrastructure stack, not used locally):
# API_KEY_SECRET_ARN=
# OPEN_PAYMENTS_SECRET_ARN=
