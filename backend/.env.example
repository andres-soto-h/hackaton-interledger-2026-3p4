# Copy to `.env` for local development. Never commit `.env`.
# Full reference: docs/CABLEADO.md

# development | test | production
NODE_ENV=development
# Local HTTP port (default 3000)
PORT=3000
# pino level: fatal | error | warn | info | debug | trace | silent (default info)
LOG_LEVEL=info

# API key expected in the `x-api-key` header (local only; in AWS it comes from Secrets Manager)
API_KEY=change-me
# Local JSON with { "walletAddressUrl", "keyId", "privateKey" } (default ./keys/open-payments.json)
OPEN_PAYMENTS_KEYS_FILE=./keys/open-payments.json

# Local secrets (in AWS they are generated in Secrets Manager). Minimum lengths below.
# Session / admin JWT signing key (>= 32 characters)
SESSION_SECRET=change-me-session-secret-at-least-32-chars
# Admin panel password (>= 12 characters)
ADMIN_PASSWORD=change-me-admin-password
# Wallet-link token encryption secret (>= 32 characters; the AES key is SHA-256 of it)
TOKEN_KEY=change-me-token-key-at-least-32-characters

# Storage: memory (default, lost on restart) | dynamo (needs PAYMENTS_TABLE_NAME)
STORAGE=memory
# PAYMENTS_TABLE_NAME=tranqui-local
# DynamoDB Local endpoint (e.g. nerdctl/Colima container on 8000)
# DYNAMODB_ENDPOINT=http://localhost:8000

# Optional (defaults in parentheses)
# CORS_ALLOWED_ORIGINS=http://localhost:8081      (empty: CORS disabled)
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=Tranqui
# WEBAUTHN_ORIGINS=http://localhost:3000
# ADMIN_ENABLED=true
# FRONTEND_RESULT_URL=                            (where the browser lands after authorizing a wallet link)
# PUBLIC_API_URL=http://localhost:3000            (base of the Open Payments callback)
# DAILY_SPEND_LIMITS=USD:200
# DAILY_LIMIT_TIMEZONE=America/Bogota
# FEE_PERCENTAGE=0
# WALLET_PROVIDER_BASE_URL=https://ilp.interledger-test.dev
# ALLOWED_WALLET_HOSTS=
# MAX_PAYMENT_AMOUNTS=USD:1000
# OPEN_PAYMENTS_TIMEOUT_MS=8000

# Lambda only (set by the infrastructure stack, not used locally):
# API_KEY_SECRET_ARN=
# OPEN_PAYMENTS_SECRET_ARN=
# SESSION_SECRET_ARN=
# ADMIN_PASSWORD_SECRET_ARN=
# TOKEN_KEY_SECRET_ARN=
# PAYMENTS_TABLE_NAME=
