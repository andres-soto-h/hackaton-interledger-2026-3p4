.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing / coverage
coverage/
.nyc_output/

# Caches
.cache/
.eslintcache
.stylelintcache
.parcel-cache/
.turbo/

